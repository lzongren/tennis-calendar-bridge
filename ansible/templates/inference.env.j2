{% macro env_quote(value) -%}
'{{ value | default('', true) | string | replace("'", "\\'") }}'
{%- endmacro %}
TENNIS_DISCOVERY_ENABLED={{ 'true' if tennis_discovery_enabled | default(false) else 'false' }}
TENNIS_DISCOVERY_API_URL={{ env_quote(tennis_discovery_api_url | default('')) }}
TENNIS_DISCOVERY_MODEL={{ env_quote(tennis_discovery_model | default('tennis-discovery')) }}
TENNIS_DISCOVERY_API_KEY={{ env_quote(vault_tennis_discovery_api_key) }}
